{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "as_of",
    "timezone",
    "summary",
    "items",
    "dispositions",
    "limitations",
    "questions"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "as_of": {
      "type": "string",
      "minLength": 1
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "categories",
          "reason",
          "importance",
          "importance_reason",
          "requested_action",
          "sources",
          "history",
          "schedule",
          "completion",
          "uncertainties"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "new_work",
                "interview",
                "irregular_request"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "importance": {
            "type": "string",
            "enum": [
              "high",
              "normal",
              "low",
              "unknown"
            ]
          },
          "importance_reason": {
            "type": "string",
            "minLength": 1
          },
          "requested_action": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "history": {
            "type": "string",
            "minLength": 1
          },
          "schedule": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "when",
              "impact"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "proposed",
                  "confirmed",
                  "changed",
                  "cancelled",
                  "unknown",
                  "none"
                ]
              },
              "when": {
                "type": "string"
              },
              "impact": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "completion": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "reason"
            ],
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "confirmed_done",
                  "confirmed_open",
                  "unknown"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "uncertainties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        }
      },
      "minItems": 0
    },
    "dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "disposition",
          "item_ids",
          "reason"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "type": "string",
            "enum": [
              "included",
              "merged",
              "reference_only",
              "excluded",
              "unresolved"
            ]
          },
          "item_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 0
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  }
}
