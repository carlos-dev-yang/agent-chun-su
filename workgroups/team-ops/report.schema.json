{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "scope", "ledger_revision", "state_digest", "as_of", "summary", "work_status", "release_status", "risks", "dispositions", "limitations"],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "scope": {"type": "object", "additionalProperties": false, "required": ["team", "project"], "properties": {"team": {"type": "string"}, "project": {"type": "string"}}},
    "ledger_revision": {"type": "integer", "minimum": 1},
    "state_digest": {"type": "string"},
    "as_of": {"type": "string"},
    "summary": {"type": "string"},
    "work_status": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["work_id", "state", "original_due", "current_due", "overdue_original", "overdue_current", "schedule_changed", "waiting_check_due", "completed_late_original", "completed_late_current"], "properties": {"work_id": {"type": "string"}, "state": {"type": "string"}, "original_due": {"type": "string"}, "current_due": {"type": "string"}, "overdue_original": {"type": "boolean"}, "overdue_current": {"type": "boolean"}, "schedule_changed": {"type": "boolean"}, "waiting_check_due": {"type": "boolean"}, "completed_late_original": {"type": "boolean"}, "completed_late_current": {"type": "boolean"}}}},
    "release_status": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["release_id", "work_id", "commitment", "readiness", "deployment", "deployment_evidence_at", "ready_deadline_passed", "deploy_deadline_passed", "disposition"], "properties": {"release_id": {"type": "string"}, "work_id": {"type": "string"}, "commitment": {"type": "string"}, "readiness": {"type": "string"}, "deployment": {"type": "string"}, "deployment_evidence_at": {"type": "string"}, "ready_deadline_passed": {"type": "boolean"}, "deploy_deadline_passed": {"type": "boolean"}, "disposition": {"type": "string"}}}},
    "risks": {"type": "array", "items": {"$ref": "#/$defs/risk"}},
    "dispositions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["source_id", "outcome", "risk_keys", "reason"], "properties": {"source_id": {"type": "string"}, "outcome": {"type": "string", "enum": ["risk", "context", "no_action", "uncertain"]}, "risk_keys": {"type": "array", "items": {"type": "string"}}, "reason": {"type": "string"}}}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "citation": {"type": "object", "additionalProperties": false, "required": ["source_id", "span_ids"], "properties": {"source_id": {"type": "string"}, "span_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "risk": {"type": "object", "additionalProperties": false, "required": ["key", "kind", "work_id", "release_id", "incident_id", "severity", "confidence", "title", "impact", "rationale", "recommended_action", "owner", "citations", "uncertainties"], "properties": {
      "key": {"type": "string"},
      "kind": {"type": "string", "enum": ["overdue", "schedule_changed", "waiting_check", "release_work_incomplete", "deployment_not_done", "deployment_unknown", "deployed_unrecorded", "external_state_conflict", "slack_risk", "source_gap"]},
      "work_id": {"type": "string"}, "release_id": {"type": "string"}, "incident_id": {"type": "string"},
      "severity": {"type": "string", "enum": ["P0", "P1", "P2", "P3"]},
      "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
      "title": {"type": "string"}, "impact": {"type": "string"}, "rationale": {"type": "string"}, "recommended_action": {"type": "string"}, "owner": {"type": "string"},
      "citations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/citation"}},
      "uncertainties": {"type": "array", "items": {"type": "string"}}
    }}
  }
}
